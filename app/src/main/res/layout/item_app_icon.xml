<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <!-- 64dp Squircle Icon Container with Gradient & Border -->
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_squircle_emerald">

        <TextView
            android:id="@+id/tv_icon_monogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SC"
            android:textColor="@color/accent_emerald"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="App Icon" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Scraffold"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

    <!-- Domain Subtitle (mangadot.net) -->
    <TextView
        android:id="@+id/tv_app_domain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="mangadot.net"
        android:textColor="@color/text_muted"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

</LinearLayout>
