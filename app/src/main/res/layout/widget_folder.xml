<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_folder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_folder"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_app1"
                style="@style/WidgetFolderCell" />

            <ImageView
                android:id="@+id/widget_folder_app2"
                style="@style/WidgetFolderCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_folder_app3"
                style="@style/WidgetFolderCell" />

            <ImageView
                android:id="@+id/widget_folder_more"
                style="@style/WidgetFolderCell"
                android:contentDescription="@string/folder_widget_name" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
