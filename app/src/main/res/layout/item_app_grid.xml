<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:padding="10dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Row: 36dp Squircle Icon + Options Menu (⋮) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/grid_icon_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_squircle_emerald">

            <TextView
                android:id="@+id/grid_tv_icon_monogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="MD"
                android:textColor="@color/accent_emerald"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Naked 3-Dots Action Button -->
        <ImageButton
            android:id="@+id/grid_btn_options"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Options" />
    </LinearLayout>

    <!-- App Title & Domain -->
    <TextView
        android:id="@+id/grid_tv_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MangaDot"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/grid_tv_app_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="mangadot.net"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Bottom Telemetry Row: Scripts Pill & Shield Metric -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/grid_tv_scripts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 scripts"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/grid_tv_blocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 blocked"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
