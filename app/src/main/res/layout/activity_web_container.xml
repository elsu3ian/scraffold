<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top Loading Indicator (Thin Emerald Line) -->
    <ProgressBar
        android:id="@+id/container_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@color/accent_emerald"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Embedded Chromium Hardware-Accelerated WebView -->
    <net.mangadot.scaffold.engine.DeckWebView
        android:id="@+id/deck_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/container_progress_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Userscript Active Floating HUD Pill -->
    <TextView
        android:id="@+id/tv_script_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:textColor="@color/accent_emerald"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quick Edge Tab (Tap to return to Shelf) -->
    <View
        android:id="@+id/btn_edge_drawer"
        android:layout_width="16dp"
        android:layout_height="80dp"
        android:background="#20FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
