<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top Loading Indicator (Thin Emerald Line) -->
    <ProgressBar
        android:id="@+id/container_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@color/accent_emerald"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Embedded Chromium Hardware-Accelerated WebView -->
    <net.mangadot.scaffold.engine.DeckWebView
        android:id="@+id/deck_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/container_progress_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Quick Edge Tab (Tap to open in-app Action Drawer) -->
    <View
        android:id="@+id/btn_edge_drawer"
        android:layout_width="16dp"
        android:layout_height="80dp"
        android:background="#20FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
