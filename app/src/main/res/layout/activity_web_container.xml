<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top Loading Indicator (Thin Emerald Line) -->
    <ProgressBar
        android:id="@+id/container_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@color/accent_emerald"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Embedded Chromium Hardware-Accelerated WebView -->
    <net.mangadot.scaffold.engine.DeckWebView
        android:id="@+id/deck_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/container_progress_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Userscript Active Floating HUD Pill -->
    <TextView
        android:id="@+id/tv_script_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:textColor="@color/accent_emerald"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Assistive Floating Dock Ball (Draggable, Half-Hides to Edge) -->
    <FrameLayout
        android:id="@+id/edge_dock_ball"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_edge_ball"
        android:elevation="12dp"
        android:alpha="0.55"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/accent_emerald"
            android:contentDescription="Assistive Dock" />
    </FrameLayout>

    <!-- Quick Action Menu Pill (Revealed on Tap) -->
    <LinearLayout
        android:id="@+id/edge_quick_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:elevation="14dp"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/edge_dock_ball"
        app:layout_constraintTop_toTopOf="@id/edge_dock_ball"
        app:layout_constraintBottom_toBottomOf="@id/edge_dock_ball">

        <ImageButton
            android:id="@+id/btn_ball_reload"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Reload" />

        <ImageButton
            android:id="@+id/btn_ball_home"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            android:contentDescription="Home Shelf" />

        <ImageButton
            android:id="@+id/btn_ball_shield"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent_emerald"
            android:contentDescription="Shield" />

        <ImageButton
            android:id="@+id/btn_ball_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close Menu" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
