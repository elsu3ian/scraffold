<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top Loading Indicator (Thin Emerald Line) -->
    <ProgressBar
        android:id="@+id/container_progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@color/accent_emerald"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Embedded Chromium Hardware-Accelerated WebView -->
    <net.mangadot.scaffold.engine.DeckWebView
        android:id="@+id/deck_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/container_progress_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Userscript Active Floating HUD Pill -->
    <TextView
        android:id="@+id/tv_script_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_solid"
        android:textColor="@color/accent_emerald"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Assistive Floating Dock Ball (Draggable, Half-Hides to Edge) -->
    <FrameLayout
        android:id="@+id/edge_dock_ball"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_edge_ball"
        android:elevation="12dp"
        android:alpha="0.55"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_ball_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/accent_emerald"
            android:contentDescription="Assistive Dock" />
    </FrameLayout>

    <!-- Quick actions, placed in an arc around the ball when it is tapped. Tapping the backdrop closes them. -->
    <FrameLayout
        android:id="@+id/edge_quick_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:clickable="true"
        android:elevation="11dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_ball_reload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary"
            android:contentDescription="Reload" />

        <ImageButton
            android:id="@+id/btn_ball_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_home"
            app:tint="@color/text_primary"
            android:contentDescription="Home Shelf" />

        <ImageButton
            android:id="@+id/btn_ball_shield"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent_emerald"
            android:contentDescription="Shield" />

        <ImageButton
            android:id="@+id/btn_ball_scripts"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_code"
            app:tint="@color/accent_emerald"
            android:contentDescription="Userscripts" />

        <ImageButton
            android:id="@+id/btn_ball_text_size"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_text_size"
            app:tint="@color/text_primary"
            android:contentDescription="Page and font size" />

        <ImageButton
            android:id="@+id/btn_ball_desktop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_desktop"
            app:tint="@color/text_primary"
            android:contentDescription="Desktop site" />

        <ImageButton
            android:id="@+id/btn_ball_copy_link"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_radial_button"
            android:src="@drawable/ic_link"
            app:tint="@color/text_primary"
            android:contentDescription="Copy link" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
