<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_cosmic"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_cosmic_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tv_cosmic_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="THEME"
                android:textColor="@color/accent_emerald"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <ImageButton
                android:id="@+id/btn_cosmic_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary"
            android:layout_marginBottom="10dp" />

        <!-- Page 1 -->
        <LinearLayout
            android:id="@+id/page_cosmic_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row_cosmic_accent"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accent color"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cosmic_accent_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <View
                android:id="@+id/view_cosmic_accent_swatch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/row_cosmic_static"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Plain background color"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cosmic_static_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <View
                android:id="@+id/view_cosmic_static_swatch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cosmic background"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_cosmic_radiant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/text_primary"
                app:trackTint="@color/switch_track" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/row_cosmic_edit_radiant"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_cosmic_edit_radiant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit the Cosmic background"
                android:textColor="@color/accent_emerald"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_cosmic_reset_theme"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_cosmic_reset"
            android:gravity="center"
            android:text="↺ Reset theme to default"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true" />

        </LinearLayout>

        <!-- Page 2: the radiant background editor -->
        <LinearLayout
            android:id="@+id/page_cosmic_radiant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Live Preview Strip -->
        <LinearLayout
            android:id="@+id/layout_cosmic_preview"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:foreground="@drawable/bg_cosmic_preview"
            android:paddingHorizontal="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cosmic_preview_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PREVIEW · 160° · 100%"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:maxLines="1" />

            <View
                android:id="@+id/view_preview_dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp" />

            <View
                android:id="@+id/view_preview_dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp" />

            <View
                android:id="@+id/view_preview_dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Master Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Glass look"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_cosmic_styling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dim the background inside apps"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_cosmic_dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Match the accent color"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_cosmic_auto_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/text_primary"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- Preset Palettes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="PRESET PALETTES"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08" />

        <!-- ChipGroup is used as a wrapping row; the pills are plain TextViews -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_cosmic_palettes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />


        <!-- Nebula Glows & Geometry -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="GLOWS"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brightness"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cosmic_intensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_cosmic_intensity"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:paddingHorizontal="8dp"
            android:max="200"
            android:progressTint="@color/accent_emerald"
            android:progressBackgroundTint="@color/border_primary"
            android:thumbTint="@color/accent_emerald" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Angle"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cosmic_rotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="160°"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seek_cosmic_rotation"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:paddingHorizontal="8dp"
                android:max="360"
                android:progressTint="@color/accent_emerald"
                android:progressBackgroundTint="@color/border_primary"
                android:thumbTint="@color/accent_emerald" />

            <TextView
                android:id="@+id/btn_cosmic_rotate"
                android:layout_width="44dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cosmic_hex"
                android:gravity="center"
                android:text="+45°"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Glow 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Top-left glow"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_cosmic_glow_1"
                android:layout_width="76dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cosmic_hex"
                android:gravity="center"
                android:padding="0dp"
                android:maxLength="7"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:hint="#000000"
                android:textColorHint="@color/text_muted" />

            <View
                android:id="@+id/view_cosmic_swatch_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Glow 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Top-right glow"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_cosmic_glow_2"
                android:layout_width="76dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cosmic_hex"
                android:gravity="center"
                android:padding="0dp"
                android:maxLength="7"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:hint="#000000"
                android:textColorHint="@color/text_muted" />

            <View
                android:id="@+id/view_cosmic_swatch_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Glow 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bottom glow"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_cosmic_glow_3"
                android:layout_width="76dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cosmic_hex"
                android:gravity="center"
                android:padding="0dp"
                android:maxLength="7"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:hint="#000000"
                android:textColorHint="@color/text_muted" />

            <View
                android:id="@+id/view_cosmic_swatch_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cosmic_sync"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cosmic_sync"
                android:gravity="center"
                android:text="↻ Match the accent now"
                android:textColor="@color/accent_emerald_bright"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_cosmic_reset"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_cosmic_reset"
                android:gravity="center"
                android:text="↺ Reset default"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Changes apply live and are saved on this device."
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
