<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Pure Obsidian Dark Mode -->
    <style name="Theme.Scaffold" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Window background and status bar -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Material3 Color Tokens -->
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border_primary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Scaffold.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Scaffold.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
        <item name="colorAccent">@color/accent_emerald</item>
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <!-- 100% True Fullscreen Theme for WebContainerActivity -->
    <style name="Theme.Scaffold.Fullscreen" parent="Theme.Scaffold">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="WidgetFolderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/widget_folder_cell_margin</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- The open folder, over a dimmed home screen. Android 12 and up also blur what's behind it.
         FolderOpening animates the dim, the blur and the panel, so the window itself has no animation -->
    <style name="Theme.Scaffold.Folder" parent="Theme.Scaffold">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowAnimationStyle">@style/Animation.Scaffold.Folder</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
    </style>

    <style name="Animation.Scaffold.Folder" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/folder_none</item>
        <item name="android:activityOpenExitAnimation">@anim/folder_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/folder_none</item>
        <item name="android:activityCloseExitAnimation">@anim/folder_none</item>
        <item name="android:taskOpenEnterAnimation">@anim/folder_none</item>
        <item name="android:taskOpenExitAnimation">@anim/folder_none</item>
        <item name="android:taskCloseEnterAnimation">@anim/folder_none</item>
        <item name="android:taskCloseExitAnimation">@anim/folder_none</item>
    </style>
</resources>
