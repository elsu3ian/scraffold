<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. Web app logins and site data must not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
